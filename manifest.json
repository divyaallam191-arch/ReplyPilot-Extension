
{
    "name":"Email Reply Assistant",
    "description":"AI-powered email reply generator",
    "version":"1.0",
    "manifest_version":3,
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },

     "permissions": ["storage"],
    "host_permissions":[
        "https://replypilot-backend-kjxi.onrender.com/*",
        "*://mail.google.com/*" 
    ],
    "content_scripts":[
        {
            "js":["content.js"],
            "matches":["*://mail.google.com/*"],
            "run-at":"document_end"
        }
    ],
    "web_accessible_resources":[
        {
            "resources":["icons/*"],
            "matches":["*://mail.google.com/*"]
        }
    ],

    "action":{
        "default_title":"Email Writer Assistant"  
    }

}